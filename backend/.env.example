# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Option 1 — full connection string
DATABASE_URL=postgresql://user:password@localhost:5432/brainforge

# Option 2 — individual fields (used when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=brainforge
# DB_USER=postgres
# DB_PASSWORD=your_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-very-strong-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-very-strong-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI Services ──────────────────────────────────────────────────────────────
LOVABLE_API_KEY=your-api-key
OPENAI_API_KEY=your-api-key
PERPLEXITY_API_KEY=your-api-key

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# ─── SMS (Ghasedak) ───────────────────────────────────────────────────────────
SMS_API_KEY=your-ghasedak-api-key
SMS_LINE_NUMBER=                        # optional: sender line number
SMS_OTP_TEMPLATE=                       # optional: OTP template name in panel

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
SITE_URL=https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ─── Admin Bootstrap ──────────────────────────────────────────────────────────
# Bootstrap the first admin: POST /create-admin with this secret
ADMIN_SECRET=your-admin-bootstrap-secret
